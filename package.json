{
  "name": "aion2-toolkit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "npm run build && node server/index.mjs",
    "preview": "vite preview",
    "data": "node scripts/fetch-data.mjs && node scripts/fetch-learn-levels.mjs && node scripts/fetch-icons.mjs && node scripts/check-curated.mjs --report",
    "data:json": "node scripts/fetch-data.mjs",
    "data:levels": "node scripts/fetch-learn-levels.mjs",
    "data:icons": "node scripts/fetch-icons.mjs",
    "check:curated": "node scripts/check-curated.mjs",
    "top": "node scripts/fetch-top-builds.mjs",
    "data:farm-tcimba": "node scripts/farm-tcimba.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/cinzel": "^5.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
